NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/edulentra
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_BASE_URL=http://localhost:5173
# Add Vercel preview origins as comma-separated values when needed.
CORS_ORIGINS=

# Optional: configure all of these to enable password-reset email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=EduLentra <no-reply@example.com>
